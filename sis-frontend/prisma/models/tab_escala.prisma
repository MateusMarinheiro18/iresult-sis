// prisma/models/escala.prisma
model Escala {
  id           Int                    @id @default(autoincrement()) @map("id_escala")
  nome         String                 @map("nome")
  dataVencimento DateTime?            @map("data_vencimento")
  ativo        Int?                   @map("ativo")
  created      DateTime?              @map("created")
  createdBy    Int?                   @map("created_by")
  deleted      DateTime?              @map("deleted")
  deletedBy    Int?                   @map("deleted_by")
  updated      DateTime?              @map("updated")
  updatedBy    Int?                   @map("updated_by")

  // relations
  empresas     EscalaHasEmpresa[]     @relation("EscalaEmpresas")
  perguntas    EscalaPergunta[]       @relation("EscalaPerguntas")
  respostas    RespostaFuncionario[]  @relation("EscalaRespostas")

  @@map("tab_escala")
}
