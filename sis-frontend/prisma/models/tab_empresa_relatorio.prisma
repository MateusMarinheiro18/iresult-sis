// prisma/models/empresa_relatorio.prisma
model EmpresaRelatorio {
  id             Int       @id @default(autoincrement()) @map("id_relatorio")
  titulo         String    @map("titulo")
  dataPublicacao DateTime? @map("data_publicacao")
  texto          String?   @map("texto")
  idEmpresa      Int       @map("id_empresa")
  ativo          Int?      @map("ativo")
  created        DateTime? @map("created")
  createdBy      Int?      @map("created_by")
  deleted        DateTime? @map("deleted")
  deletedBy      Int?      @map("deleted_by")
  updated        DateTime? @map("updated")
  updatedBy      Int?      @map("updated_by")

  // novos campos (apenas estes três)
  fileKey        String?   @map("file_key")
  fileName       String?   @map("file_name")
  versionSuffix  Int?      @default(1) @map("version_suffix")

  // Relação com Empresa
  empresa Empresa @relation("EmpresaRelatorios", fields: [idEmpresa], references: [id], onDelete: Cascade)

  @@map("tab_empresa_relatorio")
}
