model RespostaFuncionario {
  id           Int       @id @default(autoincrement()) @map("id_resposta_funcionario")
  dataResposta DateTime? @map("data_resposta")

  idResposta Int? @map("id_resposta")   // FK para resposta possível
  idPergunta Int? @map("id_pergunta")   // FK para pergunta
  idEscala   Int? @map("id_escala")     // FK para escala

  // Empresa da resposta
  idEmpresa Int? @map("id_empresa")

  // NOVO: funcionário que respondeu
  idFuncionario Int? @map("id_funcionario")

  ativo     Int?      @map("ativo")
  created   DateTime? @map("created")
  createdBy Int?      @map("created_by")
  deleted   DateTime? @map("deleted")
  deletedBy Int?      @map("deleted_by")
  updated   DateTime? @map("updated")
  updatedBy Int?      @map("updated_by")

  // relations
  respostaPossivel EscalaPerguntaResposta? @relation("RespostaPossivelFuncionarios", fields: [idResposta], references: [id], onDelete: SetNull)
  pergunta         EscalaPergunta?         @relation("PerguntaRespostasFuncionario", fields: [idPergunta], references: [id], onDelete: SetNull)
  escala           Escala?                 @relation("EscalaRespostas", fields: [idEscala], references: [id], onDelete: SetNull)
  empresa          Empresa?                @relation("EmpresaRespostasFuncionario", fields: [idEmpresa], references: [id], onDelete: SetNull)
  funcionario      EmpresaFuncionario?     @relation("FuncionarioRespostas", fields: [idFuncionario], references: [id_funcionario], onDelete: SetNull)

  @@map("tab_resposta_funcionario")
}
