// prisma/models/escala_has_empresa.prisma
model EscalaHasEmpresa {
  idEscala  Int @map("id_escala")
  idEmpresa Int @map("id_empresa")

  // NOVO: quantos funcionários foram convidados quando a escala foi disparada
  totalDestinatarios Int?      @map("total_destinatarios")

  // NOVO: quando essa escala foi enviada para essa empresa
  dataEnvio DateTime? @map("data_envio")

  // relations
  escala  Escala  @relation("EscalaEmpresas", fields: [idEscala], references: [id], onDelete: Cascade)
  empresa Empresa @relation("EscalaHasEmpresas", fields: [idEmpresa], references: [id], onDelete: Cascade)

  @@id([idEscala, idEmpresa])
  @@map("tab_escala_has_empresa")
}
