// ---- tab_escala_categoria.prisma ----
// prisma/models/escala_categoria.prisma
model EscalaCategoria {
  id       Int    @id @default(autoincrement()) @map("id_categoria")
  nome     String @map("nome")
  idModulo Int    @map("id_modulo")

  ativo      Int?      @map("ativo")
  created    DateTime? @map("created")
  createdBy  Int?      @map("created_by")
  deleted    DateTime? @map("deleted")
  deletedBy  Int?      @map("deleted_by")
  updated    DateTime? @map("updated")
  updatedBy  Int?      @map("updated_by")

  // Relações
  modulo    EscalaModulo     @relation("ModuloCategorias", fields: [idModulo], references: [id], onDelete: Cascade)
  perguntas EscalaPergunta[] @relation("CategoriaPerguntas")

  @@map("tab_escala_categoria")
}
