model EscalaPerguntaCategoria {
  // FK para pergunta
  pergunta    EscalaPergunta @relation("PerguntaCategorias", fields: [perguntaId], references: [id], onDelete: Cascade)
  perguntaId  Int             @map("id_pergunta")

  // FK para categoria
  categoria   EscalaCategoria @relation("CategoriaPerguntasJoin", fields: [categoriaId], references: [id], onDelete: Restrict)
  categoriaId Int             @map("id_categoria")

  // opcional: ordem das categorias associadas à pergunta
  ordem       Int?            @map("ordem")

  // metadata
  created     DateTime?       @map("created")

  @@id([perguntaId, categoriaId])
  @@index([categoriaId], map: "idx_escala_pergunta_categoria_categoria")
  @@map("tab_escala_pergunta_categoria")
}
