model EscalaPergunta {
  id       Int       @id @default(autoincrement()) @map("id_pergunta")
  pergunta String    @map("pergunta")
  idEscala Int       @map("id_escala")

  // ordem da pergunta dentro da escala/módulo
  ordem Int? @map("ordem")

  // módulo ao qual a pergunta pertence (mantido)
  idModulo Int?          @map("id_modulo")
  // NOTA: idCategoria removido — agora usamos a tabela de relacionamento many-to-many

  ativo     Int?      @map("ativo")
  created   DateTime? @map("created")
  createdBy Int?      @map("created_by")
  deleted   DateTime? @map("deleted")
  deletedBy Int?      @map("deleted_by")
  updated   DateTime? @map("updated")
  updatedBy Int?      @map("updated_by")

  // relations
  escala Escala @relation("EscalaPerguntas", fields: [idEscala], references: [id], onDelete: Cascade)

  // relação com módulo (permanece)
  modulo    EscalaModulo?            @relation("ModuloPerguntas", fields: [idModulo], references: [id])

  // NOVA relação -> join table (pergunta <-> categorias)
  categoriasRel EscalaPerguntaCategoria[] @relation("PerguntaCategorias")

  respostasPossiveis    EscalaPerguntaResposta[] @relation("PerguntaRespostas")
  respostasFuncionarios RespostaFuncionario[]    @relation("PerguntaRespostasFuncionario")

  @@index([idEscala], map: "tab_escala_pergunta_id_escala_fkey")
  @@index([idModulo], map: "tab_escala_pergunta_id_modulo_fkey")
  @@map("tab_escala_pergunta")
}
