// ---- tab_escala_modulo.prisma ----
// prisma/models/escala_modulo.prisma
model EscalaModulo {
  id       Int       @id @default(autoincrement()) @map("id_modulo")
  nome     String    @map("nome")
  idEscala Int       @map("id_escala")

  // Ranges por módulo (usados com a média 1–5 das respostas)
  valorInicialFavoravel     Decimal? @map("valor_inicial_favoravel")     @db.Decimal(10,2)
  valorFinalFavoravel       Decimal? @map("valor_final_favoravel")       @db.Decimal(10,2)
  valorInicialIntermediario Decimal? @map("valor_inicial_intermediario") @db.Decimal(10,2)
  valorFinalIntermediario   Decimal? @map("valor_final_intermediario")   @db.Decimal(10,2)
  valorInicialRisco         Decimal? @map("valor_inicial_risco")         @db.Decimal(10,2)
  valorFinalRisco           Decimal? @map("valor_final_risco")           @db.Decimal(10,2)

  ativo      Int?      @map("ativo")
  created    DateTime? @map("created")
  createdBy  Int?      @map("created_by")
  deleted    DateTime? @map("deleted")
  deletedBy  Int?      @map("deleted_by")
  updated    DateTime? @map("updated")
  updatedBy  Int?      @map("updated_by")

  // Relações
  escala     Escala            @relation("EscalaModulos", fields: [idEscala], references: [id], onDelete: Cascade)
  categorias EscalaCategoria[] @relation("ModuloCategorias")
  perguntas  EscalaPergunta[]  @relation("ModuloPerguntas")

  @@map("tab_escala_modulo")
}
