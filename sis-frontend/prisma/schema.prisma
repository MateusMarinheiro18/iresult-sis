generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Administrador {
  id        Int    @id @default(autoincrement()) @map("id_administrador")
  nome      String @map("nome")
  email     String @map("email")
  senhaHash String @map("senha_hash")

  @@map("tab_administrador")
}

model Empresa {
  id                    Int                   @id @default(autoincrement()) @map("id_empresa")
  razaoSocial           String                @map("razao_social")
  cnpj                  String?               @map("CNPJ")
  email                 String?               @map("email")
  telefone              String?               @map("telefone")
  cep                   String?               @map("CEP")
  ativo                 Int?                  @map("ativo")
  created               DateTime?             @map("created")
  createdBy             Int?                  @map("created_by")
  deleted               DateTime?             @map("deleted")
  deletedBy             Int?                  @map("deleted_by")
  updated               DateTime?             @map("updated")
  updatedBy             Int?                  @map("updated_by")
  cidade                String?               @map("cidade")
  complemento           String?               @map("complemento")
  estado                String?               @map("estado")
  logradouro            String?               @map("logradouro")
  numero                String?               @map("numero")
  pais                  String?               @map("pais")
  logoFileName          String?               @map("logo_file_name")
  funcionarios          EmpresaFuncionario[]  @relation("EmpresaFuncionarios")
  gruposFuncionarios    EmpresaGrupo[]        @relation("EmpresaGrupos")
  empresasTrilhas       EmpresaHasTrilha[]    @relation("EmpresaTrilhas")
  relatorios            EmpresaRelatorio[]    @relation("EmpresaRelatorios")
  usuarios              EmpresaUsuario[]      @relation("EmpresaUsuarios")
  escalasEmpresas       EscalaHasEmpresa[]    @relation("EscalaHasEmpresas")
  respostasFuncionarios RespostaFuncionario[] @relation("EmpresaRespostasFuncionario")

  @@map("tab_empresa")
}

model EmpresaFuncionario {
  id_funcionario    Int                   @id @default(autoincrement()) @map("id_funcionario")
  nome              String?               @map("nome")
  gestor            String?               @map("gestor")
  email             String?               @map("email")
  telefone          String?               @map("telefone")
  data_nascimento   DateTime?             @map("data_nascimento")
  cidade_nascimento String?               @map("cidade_nascimento")
  id_empresa        Int?                  @map("id_empresa")
  ativo             Int?                  @map("ativo")
  created           DateTime?             @map("created")
  created_by        Int?                  @map("created_by")
  deleted           DateTime?             @map("deleted")
  deleted_by        Int?                  @map("deleted_by")
  updated           DateTime?             @map("updated")
  updated_by        Int?                  @map("updated_by")
  id_grupo          Int?                  @map("id_grupo")
  empresa           Empresa?              @relation("EmpresaFuncionarios", fields: [id_empresa], references: [id])
  grupo             EmpresaGrupo?         @relation("GrupoFuncionarios", fields: [id_grupo], references: [id])
  respostas         RespostaFuncionario[] @relation("FuncionarioRespostas")

  @@index([id_empresa], map: "tab_empresa_funcionario_id_empresa_fkey")
  @@index([id_grupo], map: "tab_empresa_funcionario_id_grupo_fkey")
  @@map("tab_empresa_funcionario")
}

model EmpresaGrupo {
  id           Int                  @id @default(autoincrement()) @map("id_grupo")
  nome         String               @map("nome")
  idEmpresa    Int                  @map("id_empresa")
  ativo        Int?                 @map("ativo")
  created      DateTime?            @map("created")
  createdBy    Int?                 @map("created_by")
  deleted      DateTime?            @map("deleted")
  deletedBy    Int?                 @map("deleted_by")
  updated      DateTime?            @map("updated")
  updatedBy    Int?                 @map("updated_by")
  funcionarios EmpresaFuncionario[] @relation("GrupoFuncionarios")
  empresa      Empresa              @relation("EmpresaGrupos", fields: [idEmpresa], references: [id], onDelete: Cascade)

  @@unique([idEmpresa, nome])
  @@map("tab_empresa_grupo")
}

model EmpresaHasTrilha {
  idEmpresa Int     @map("id_empresa")
  idTrilha  Int     @map("id_trilha")
  empresa   Empresa @relation("EmpresaTrilhas", fields: [idEmpresa], references: [id], onDelete: Cascade)
  trilha    Trilha  @relation("TrilhaEmpresas", fields: [idTrilha], references: [id], onDelete: Cascade)

  @@id([idEmpresa, idTrilha])
  @@index([idTrilha], map: "tab_empresa_has_trilha_id_trilha_fkey")
  @@map("tab_empresa_has_trilha")
}

model EmpresaRelatorio {
  id             Int       @id @default(autoincrement()) @map("id_relatorio")
  titulo         String    @map("titulo")
  dataPublicacao DateTime? @map("data_publicacao")
  texto          String?   @map("texto")
  idEmpresa      Int       @map("id_empresa")
  ativo          Int?      @map("ativo")
  created        DateTime? @map("created")
  createdBy      Int?      @map("created_by")
  deleted        DateTime? @map("deleted")
  deletedBy      Int?      @map("deleted_by")
  updated        DateTime? @map("updated")
  updatedBy      Int?      @map("updated_by")
  fileKey        String?   @map("file_key")
  fileName       String?   @map("file_name")
  versionSuffix  Int?      @default(1) @map("version_suffix")
  empresa        Empresa   @relation("EmpresaRelatorios", fields: [idEmpresa], references: [id], onDelete: Cascade)

  @@index([idEmpresa], map: "tab_empresa_relatorio_id_empresa_fkey")
  @@map("tab_empresa_relatorio")
}

model EmpresaUsuario {
  id_usuario_rh   Int       @id @default(autoincrement()) @map("id_usuario_rh")
  nome            String?   @map("nome")
  data_nascimento DateTime? @map("data_nascimento")
  email           String?   @map("email")
  telefone        String?   @map("telefone")
  gestor          String?   @map("gestor")
  cidade          String?   @map("cidade")
  senha_hash      String?   @map("senha_hash")
  id_empresa      Int?      @map("id_empresa")
  ativo           Int?      @map("ativo")
  created         DateTime? @map("created")
  created_by      Int?      @map("created_by")
  deleted         DateTime? @map("deleted")
  deleted_by      Int?      @map("deleted_by")
  updated         DateTime? @map("updated")
  updated_by      Int?      @map("updated_by")
  empresa         Empresa?  @relation("EmpresaUsuarios", fields: [id_empresa], references: [id])

  @@index([id_empresa], map: "tab_empresa_usuario_id_empresa_fkey")
  @@map("tab_empresa_usuario")
}

model Escala {
  id             Int                   @id @default(autoincrement()) @map("id_escala")
  nome           String                @map("nome")
  dataVencimento DateTime?             @map("data_vencimento")
  ativo          Int?                  @map("ativo")
  created        DateTime?             @map("created")
  createdBy      Int?                  @map("created_by")
  deleted        DateTime?             @map("deleted")
  deletedBy      Int?                  @map("deleted_by")
  updated        DateTime?             @map("updated")
  updatedBy      Int?                  @map("updated_by")
  empresas       EscalaHasEmpresa[]    @relation("EscalaEmpresas")
  modulos        EscalaModulo[]        @relation("EscalaModulos")
  perguntas      EscalaPergunta[]      @relation("EscalaPerguntas")
  respostas      RespostaFuncionario[] @relation("EscalaRespostas")

  @@map("tab_escala")
}

model EscalaCategoria {
  id            Int                          @id @default(autoincrement()) @map("id_categoria")
  nome          String                       @map("nome")
  idModulo      Int                          @map("id_modulo")
  ativo         Int?                         @map("ativo")
  created       DateTime?                    @map("created")
  createdBy     Int?                         @map("created_by")
  deleted       DateTime?                    @map("deleted")
  deletedBy     Int?                         @map("deleted_by")
  updated       DateTime?                    @map("updated")
  updatedBy     Int?                         @map("updated_by")
  modulo        EscalaModulo                 @relation("ModuloCategorias", fields: [idModulo], references: [id], onDelete: Cascade)
  categoriasRel EscalaPerguntaHasCategoria[] @relation("CategoriaPerguntasJoin")

  @@index([idModulo], map: "tab_escala_categoria_id_modulo_fkey")
  @@map("tab_escala_categoria")
}

model EscalaHasEmpresa {
  idEscala           Int       @map("id_escala")
  idEmpresa          Int       @map("id_empresa")
  dataEnvio          DateTime? @map("data_envio")
  totalDestinatarios Int?      @map("total_destinatarios")
  empresa            Empresa   @relation("EscalaHasEmpresas", fields: [idEmpresa], references: [id], onDelete: Cascade)
  escala             Escala    @relation("EscalaEmpresas", fields: [idEscala], references: [id], onDelete: Cascade)

  @@id([idEscala, idEmpresa])
  @@index([idEmpresa], map: "tab_escala_has_empresa_id_empresa_fkey")
  @@map("tab_escala_has_empresa")
}

model EscalaModulo {
  id                        Int               @id @default(autoincrement()) @map("id_modulo")
  nome                      String            @map("nome")
  idEscala                  Int               @map("id_escala")
  valorInicialFavoravel     Decimal?          @map("valor_inicial_favoravel") @db.Decimal(10, 2)
  valorFinalFavoravel       Decimal?          @map("valor_final_favoravel") @db.Decimal(10, 2)
  valorInicialIntermediario Decimal?          @map("valor_inicial_intermediario") @db.Decimal(10, 2)
  valorFinalIntermediario   Decimal?          @map("valor_final_intermediario") @db.Decimal(10, 2)
  valorInicialRisco         Decimal?          @map("valor_inicial_risco") @db.Decimal(10, 2)
  valorFinalRisco           Decimal?          @map("valor_final_risco") @db.Decimal(10, 2)
  ativo                     Int?              @map("ativo")
  created                   DateTime?         @map("created")
  createdBy                 Int?              @map("created_by")
  deleted                   DateTime?         @map("deleted")
  deletedBy                 Int?              @map("deleted_by")
  updated                   DateTime?         @map("updated")
  updatedBy                 Int?              @map("updated_by")
  categorias                EscalaCategoria[] @relation("ModuloCategorias")
  escala                    Escala            @relation("EscalaModulos", fields: [idEscala], references: [id], onDelete: Cascade)
  perguntas                 EscalaPergunta[]  @relation("ModuloPerguntas")

  @@index([idEscala], map: "tab_escala_modulo_id_escala_fkey")
  @@map("tab_escala_modulo")
}

model EscalaPergunta {
  id                    Int                          @id @default(autoincrement()) @map("id_pergunta")
  pergunta              String                       @map("pergunta")
  idEscala              Int                          @map("id_escala")
  ativo                 Int?                         @map("ativo")
  created               DateTime?                    @map("created")
  createdBy             Int?                         @map("created_by")
  deleted               DateTime?                    @map("deleted")
  deletedBy             Int?                         @map("deleted_by")
  updated               DateTime?                    @map("updated")
  updatedBy             Int?                         @map("updated_by")
  idModulo              Int?                         @map("id_modulo")
  ordem                 Int?                         @map("ordem")
  escala                Escala                       @relation("EscalaPerguntas", fields: [idEscala], references: [id], onDelete: Cascade)
  modulo                EscalaModulo?                @relation("ModuloPerguntas", fields: [idModulo], references: [id])
  categoriasRel         EscalaPerguntaHasCategoria[] @relation("PerguntaCategorias")
  respostasPossiveis    EscalaPerguntaResposta[]     @relation("PerguntaRespostas")
  respostasFuncionarios RespostaFuncionario[]        @relation("PerguntaRespostasFuncionario")

  @@index([idEscala], map: "tab_escala_pergunta_id_escala_fkey")
  @@index([idModulo], map: "tab_escala_pergunta_id_modulo_fkey")
  @@map("tab_escala_pergunta")
}

model EscalaPerguntaHasCategoria {
  idPergunta  Int             @map("id_pergunta")
  idCategoria Int             @map("id_categoria")
  categoria   EscalaCategoria @relation("CategoriaPerguntasJoin", fields: [idCategoria], references: [id], onDelete: Cascade)
  pergunta    EscalaPergunta  @relation("PerguntaCategorias", fields: [idPergunta], references: [id], onDelete: Cascade)

  @@id([idPergunta, idCategoria])
  @@index([idCategoria], map: "tab_escala_pergunta_has_categoria_id_categoria_fkey")
  @@map("tab_escala_pergunta_has_categoria")
}

model EscalaPerguntaResposta {
  id                   Int                   @id @default(autoincrement()) @map("id_resposta")
  resposta             String                @map("resposta")
  idPergunta           Int                   @map("id_pergunta")
  ativo                Int?                  @map("ativo")
  created              DateTime?             @map("created")
  createdBy            Int?                  @map("created_by")
  deleted              DateTime?             @map("deleted")
  deletedBy            Int?                  @map("deleted_by")
  updated              DateTime?             @map("updated")
  updatedBy            Int?                  @map("updated_by")
  valor                Int?                  @map("valor")
  pergunta             EscalaPergunta        @relation("PerguntaRespostas", fields: [idPergunta], references: [id], onDelete: Cascade)
  respostasFuncionario RespostaFuncionario[] @relation("RespostaPossivelFuncionarios")

  @@index([idPergunta], map: "tab_escala_pergunta_resposta_id_pergunta_fkey")
  @@map("tab_escala_pergunta_resposta")
}

model RespostaFuncionario {
  id               Int                     @id @default(autoincrement()) @map("id_resposta_funcionario")
  dataResposta     DateTime?               @map("data_resposta")
  idResposta       Int?                    @map("id_resposta")
  idPergunta       Int?                    @map("id_pergunta")
  idEscala         Int?                    @map("id_escala")
  ativo            Int?                    @map("ativo")
  created          DateTime?               @map("created")
  createdBy        Int?                    @map("created_by")
  deleted          DateTime?               @map("deleted")
  deletedBy        Int?                    @map("deleted_by")
  updated          DateTime?               @map("updated")
  updatedBy        Int?                    @map("updated_by")
  idEmpresa        Int?                    @map("id_empresa")
  idFuncionario    Int?                    @map("id_funcionario")
  empresa          Empresa?                @relation("EmpresaRespostasFuncionario", fields: [idEmpresa], references: [id])
  escala           Escala?                 @relation("EscalaRespostas", fields: [idEscala], references: [id])
  funcionario      EmpresaFuncionario?     @relation("FuncionarioRespostas", fields: [idFuncionario], references: [id_funcionario])
  pergunta         EscalaPergunta?         @relation("PerguntaRespostasFuncionario", fields: [idPergunta], references: [id])
  respostaPossivel EscalaPerguntaResposta? @relation("RespostaPossivelFuncionarios", fields: [idResposta], references: [id])

  @@index([idEmpresa], map: "tab_resposta_funcionario_id_empresa_fkey")
  @@index([idEscala], map: "tab_resposta_funcionario_id_escala_fkey")
  @@index([idFuncionario], map: "tab_resposta_funcionario_id_funcionario_fkey")
  @@index([idPergunta], map: "tab_resposta_funcionario_id_pergunta_fkey")
  @@index([idResposta], map: "tab_resposta_funcionario_id_resposta_fkey")
  @@map("tab_resposta_funcionario")
}

model Trilha {
  id          Int                @id @default(autoincrement()) @map("id_trilha")
  nome        String             @map("nome")
  dataCriacao DateTime?          @map("data_criacao")
  ativo       Int?               @map("ativo")
  created     DateTime?          @map("created")
  createdBy   Int?               @map("created_by")
  deleted     DateTime?          @map("deleted")
  deletedBy   Int?               @map("deleted_by")
  updated     DateTime?          @map("updated")
  updatedBy   Int?               @map("updated_by")
  empresas    EmpresaHasTrilha[] @relation("TrilhaEmpresas")
  itens       TrilhaItem[]       @relation("TrilhaItens")

  @@map("tab_trilha")
}

model TrilhaItem {
  id        Int       @id @default(autoincrement()) @map("id_itens")
  nome      String    @map("nome")
  tipo      String?   @map("tipo")
  data      DateTime? @map("data")
  detalhes  String?   @map("detalhes")
  idTrilha  Int       @map("id_trilha")
  ativo     Int?      @map("ativo")
  created   DateTime? @map("created")
  createdBy Int?      @map("created_by")
  deleted   DateTime? @map("deleted")
  deletedBy Int?      @map("deleted_by")
  updated   DateTime? @map("updated")
  updatedBy Int?      @map("updated_by")
  trilha    Trilha    @relation("TrilhaItens", fields: [idTrilha], references: [id], onDelete: Cascade)

  @@index([idTrilha], map: "tab_trilha_item_id_trilha_fkey")
  @@map("tab_trilha_item")
}
